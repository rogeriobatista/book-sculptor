# Local Docker Postgres (default container: user/pass/db = postgres/postgres/booksculptor)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/booksculptor
# DATABASE_URL=sqlite:///./.data/booksculptor.db
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: allow private LAN browser origins (prefer ngrok + scripts/dev-tunnel.ps1 instead)
API_ALLOW_LAN=false
LAN_HOST=
AUTH_DEV_BYPASS=false

CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_...
CLERK_AUDIENCE=

STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --print-secret` while forwarding to the local API
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...
STRIPE_SUCCESS_URL=http://localhost:3000/en/pricing?success=1
STRIPE_CANCEL_URL=http://localhost:3000/en/pricing?canceled=1

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=book-sculptor
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=

# --- LLM: OpenAI cloud OR any OpenAI-compatible server ---
# Base URL must end with /v1 (chat completions path is appended).
#
# OpenAI cloud (default):
#   LLM_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL_PRO=gpt-4o-mini
#   LLM_MODEL_STUDIO=gpt-4o
#
# Ollama (local):
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
#   # or per plan:
#   LLM_MODEL_PRO=llama3.2
#   LLM_MODEL_STUDIO=llama3.2
#
# LM Studio / LocalAI / vLLM / custom server:
#   LLM_BASE_URL=http://127.0.0.1:1234/v1
#   LLM_API_KEY=   # optional for many local servers
#   LLM_MODEL=your-model-id
#
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_MODEL_PRO=gpt-4o-mini
LLM_MODEL_STUDIO=gpt-4o
LLM_TIMEOUT_SECONDS=180
LLM_REQUIRE_API_KEY=false

LOCAL_STORAGE_DIR=.storage
